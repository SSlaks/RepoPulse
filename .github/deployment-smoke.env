# Public, synthetic fixture for the manual "Deployment Smoke" workflow
# (.github/workflows/deployment-smoke.yml). Every value here is fake and may be
# committed. Never place real credentials in this file.
#
# GIT_SHA / BACKEND_IMAGE / FRONTEND_IMAGE and the per-phase
# SMOKE_ENVIRONMENT / SMOKE_SEED_DEMO_DATA overrides are supplied by the job
# environment (shell env takes precedence over --env-file), so the same fixture
# drives both the demo and the production smoke project without editing it.
ENVIRONMENT=production
POSTGRES_DB=repopulse
POSTGRES_USER=repopulse
POSTGRES_PASSWORD=smoke-postgres-password-0123456789abcdef
REDIS_PASSWORD=smoke-redis-password-0123456789abcdef
DATABASE_URL=postgresql+psycopg_async://repopulse:smoke-postgres-password-0123456789abcdef@postgres:5432/repopulse
SYNC_DATABASE_URL=postgresql+psycopg://repopulse:smoke-postgres-password-0123456789abcdef@postgres:5432/repopulse
REDIS_URL=redis://:smoke-redis-password-0123456789abcdef@redis:6379/0
TRUSTED_PROXY_TOKEN=smoke-trusted-proxy-token-0123456789abcdef
INTERNAL_SERVICE_TOKEN=smoke-internal-service-token-0123456789abcdef
FRONTEND_ORIGINS=https://repopulse-smoke.invalid
NEXT_PUBLIC_SITE_URL=https://repopulse-smoke.invalid
API_BASE_URL=http://api:8000
GITHUB_TOKEN=
SENTRY_DSN=
