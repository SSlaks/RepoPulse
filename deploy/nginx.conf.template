# Render this file with envsubst before loading it into Nginx. Keep the
# rendered file readable only by the Nginx service because it contains the
# trusted proxy token.
#
#   envsubst '${NEXT_PUBLIC_SITE_HOST} ${TRUSTED_PROXY_TOKEN}' \
#     < deploy/nginx.conf.template > /etc/nginx/conf.d/repopulse.conf

server {
    listen 80;
    listen [::]:80;
    server_name ${NEXT_PUBLIC_SITE_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NEXT_PUBLIC_SITE_HOST};

    ssl_certificate /etc/letsencrypt/live/${NEXT_PUBLIC_SITE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NEXT_PUBLIC_SITE_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    # Never expose the FastAPI internal lease coordinator through the public
    # virtual host. Next talks to it over the private Docker network.
    location ^~ /internal/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_read_timeout 610s;
        proxy_send_timeout 610s;
        proxy_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-RepoPulse-Client-IP $remote_addr;
        proxy_set_header X-RepoPulse-Proxy-Token "${TRUSTED_PROXY_TOKEN}";

        # Do not allow a caller supplied forwarding chain to become an
        # identity. FastAPI only accepts the dedicated headers above.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
    }
}
