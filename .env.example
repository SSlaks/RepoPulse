# Docker Compose development values. Replace both passwords before sharing the host.
ENVIRONMENT=development
POSTGRES_DB=repopulse
POSTGRES_USER=repopulse
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-local-redis-password
DATABASE_URL=postgresql+psycopg_async://repopulse:replace-with-a-local-postgres-password@postgres:5432/repopulse
SYNC_DATABASE_URL=postgresql+psycopg://repopulse:replace-with-a-local-postgres-password@postgres:5432/repopulse
REDIS_URL=redis://:replace-with-a-local-redis-password@redis:6379/0
TRUSTED_PROXY_TOKEN=dev-only-trusted-proxy-token-32-bytes
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-32b
BACKEND_IMAGE=repopulse-backend:local
FRONTEND_IMAGE=repopulse-frontend:local
GIT_SHA=local
API_BASE_URL=http://api:8000
SEED_DEMO_DATA=true
GITHUB_TOKEN=
CANDIDATE_LANGUAGES=TypeScript,JavaScript,Python,Go,Rust,Java,C++,C#,Swift,Kotlin,PHP,Ruby,Dart,Shell
CANDIDATE_TOPICS=ai,llm,developer-tools,database,web-framework,self-hosted
MANUAL_SEED_REPOSITORIES=
EXCLUDED_REPOSITORIES=
REPOSITORY_AUTO_QUARANTINE=false
REPOSITORY_PROBE_ENABLED=true
SNAPSHOT_DEADLINE_HOURS=6
RANKING_MIN_COMPLETENESS_PERCENT=95
MAX_ACTIVE_REPOSITORIES=5000
GITHUB_SEARCH_PAGES=2
SNAPSHOT_CONCURRENCY=4
SNAPSHOT_REQUESTS_PER_SECOND=4
SNAPSHOT_BATCH_SIZE=50
SNAPSHOT_FLUSH_SECONDS=5
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
