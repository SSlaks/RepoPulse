# Copy to .env.production and replace every CHANGE_ME value.
ENVIRONMENT=production
POSTGRES_DB=repopulse
POSTGRES_USER=repopulse
POSTGRES_PASSWORD=CHANGE_ME_random_postgres_password
REDIS_PASSWORD=CHANGE_ME_random_redis_password
DATABASE_URL=postgresql+psycopg_async://repopulse:CHANGE_ME_url_encoded_postgres_password@postgres:5432/repopulse
SYNC_DATABASE_URL=postgresql+psycopg://repopulse:CHANGE_ME_url_encoded_postgres_password@postgres:5432/repopulse
REDIS_URL=redis://:CHANGE_ME_url_encoded_redis_password@redis:6379/0
TRUSTED_PROXY_TOKEN=CHANGE_ME_random_trusted_proxy_token_at_least_32_chars
INTERNAL_SERVICE_TOKEN=CHANGE_ME_random_internal_service_token_at_least_32_chars
BACKEND_IMAGE=repopulse-backend:CHANGE_ME_git_sha
FRONTEND_IMAGE=repopulse-frontend:CHANGE_ME_git_sha
GIT_SHA=CHANGE_ME_git_sha
API_BASE_URL=http://api:8000
SEED_DEMO_DATA=false
GITHUB_TOKEN=
EXCLUDED_REPOSITORIES=
REPOSITORY_AUTO_QUARANTINE=false
REPOSITORY_PROBE_ENABLED=true
SNAPSHOT_DEADLINE_HOURS=6
RANKING_MIN_COMPLETENESS_PERCENT=95
MAX_ACTIVE_REPOSITORIES=5000
GITHUB_SEARCH_PAGES=2
SNAPSHOT_CONCURRENCY=4
SNAPSHOT_REQUESTS_PER_SECOND=4
SNAPSHOT_BATCH_SIZE=50
SNAPSHOT_FLUSH_SECONDS=5
README_REFRESH_HOURS=24
README_BATCH_SIZE=100
README_REFRESH_INTERVAL_SECONDS=600
README_REQUESTS_PER_SECOND=0.5
README_QUOTA_RESERVE=1000
README_JOB_TIMEOUT_SECONDS=1800
README_FAILURE_BACKOFF_SECONDS=300
README_QUEUE_COOLDOWN_SECONDS=300
README_COLLECTION_PAUSE_HOURS=6
README_CACHE_TTL_SECONDS=300
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
FRONTEND_ORIGINS=https://repopulse.example.com
NEXT_PUBLIC_SITE_URL=https://repopulse.example.com
